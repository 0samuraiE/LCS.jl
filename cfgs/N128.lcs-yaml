outdir: "test"
mode:
  kind: "flow-particle"
backend:
  kind: "cuda"
topo:
  proc_dims:
    - 0
    - 0
    - 0
  reorder: false
grid:
  dims:
    - 128
    - 128
    - 128
  halo_size: 3
timestep:
  cfl: 0.3
  dtmax: 0.01
simulate:
  last_step: 10000
  interval_stat: 100
  interval_restart: 1000
  interval_gc: 1000
  num_restart_files: 3
flow:
  params:
    U0_m_s: 0.429
    L0_m: 0.005
    NU_m2_s: 1.5e-5
  init:
    kind: "random-flow"
    params:
      seed: 0
  couple:
    kind: "hsmac"
    params:
      overlap: true
      time_blocking: true
      coloring:
        kind: "red-black-fast"
      omega: 1.7
      epsp: 0.001
      itrmin: 6
      itrmax: 300
  forcing:
    kind: "linear-power"
    params:
      power: 0.5
  stat:
    integral_length: true
particles:
  - population:
      valid: 262144
      invalid_ratio: 0.5
      exchange_ratio: 0.01
    params:
      gravity: 0.0
      density_ratio: 843.0
    cell:
      grid_ratio: 4
    stat:
      rdf:
        contact_tolerance: 0.01
        bin_size: 16
        min_radius: 1.0e-3
        search_cell_size: 1
      spectrum:
        max_wavenumber: 128
        nsamples: 64
    drag:
      kind: "nonlinear"
    init:
      id:
        kind: "generate"
      position:
        kind: "random"
      velocity:
        kind: "rest"
      size:
        kind: "const"
        params:
          diam_m: 1.073e-05

  - population:
      valid: 262144
      invalid_ratio: 0.5
